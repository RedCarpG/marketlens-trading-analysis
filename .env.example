# 复制为 .env 并填写。.env 已在 .gitignore 中，不要提交。
# eToro 行情密钥（只读权限即可）
ETORO_API_KEY=
ETORO_USER_KEY=

# 可选：读取个人交易记录（已平仓、当前持仓）用的单独只读密钥，不需要任何写权限
ETORO_TRADE_API_KEY=
ETORO_TRADE_USER_KEY=

# 可选：实时K线使用的报价 bid / ask / mid / last（默认 bid，需与 eToro 历史K线口径核对）
ETORO_PRICE=bid
# 可选：跳过搜索，直接指定 instrumentId，例如 GOLD=18（ID 需在 eToro 核实）
ETORO_SYMBOL_MAP=

# 可选：本地K线存储目录（默认 var/candles）
ETORO_STORE_DIR=

# 经济日历与新闻（公开来源，不需要密钥即可使用）
# 可选：BLS 公共 API 注册密钥（不填用 v1，每天 25 次，本工具约用几次；填了用 v2，每天 500 次）
BLS_API_KEY=
# 可选：请求 BLS 等官方网站时的 User-Agent。BLS 拒绝访问（403）时，按其要求写上联系方式，如 MarketLens/0.4 (you@example.com)
EVENTS_UA=
# 可选：追加新闻 RSS，名称|地址，多个用逗号分隔（地址里不能有逗号），如 FXStreet|https://www.fxstreet.com/rss/news
NEWS_FEEDS=
# 可选：日历存储目录（默认 var/events）
EVENTS_DIR=

# 本地代理只监听本机
HOST=127.0.0.1
PORT=8787
