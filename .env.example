# 复制为 .env 并填写。.env 已在 .gitignore 中，不要提交。
# eToro 行情密钥（只读权限即可）
ETORO_API_KEY=
ETORO_USER_KEY=

# 可选：读取个人交易记录（已平仓、当前持仓）用的单独只读密钥，不需要任何写权限
ETORO_TRADE_API_KEY=
ETORO_TRADE_USER_KEY=

# 可选：实时K线使用的报价 bid / ask / mid / last（默认 bid，需与 eToro 历史K线口径核对）
ETORO_PRICE=bid
# 可选：跳过搜索，直接指定 instrumentId，例如 GOLD=18（ID 需在 eToro 核实）
ETORO_SYMBOL_MAP=

# 可选：本地K线存储目录（默认 var/candles）
ETORO_STORE_DIR=

# 经济日历与新闻（公开来源，不需要密钥即可使用）
# 可选：BLS 公共 API 注册密钥（不填用 v1，每天 25 次，本工具约用几次；填了用 v2，每天 500 次）
BLS_API_KEY=
# 可选：请求 BLS 等官方网站时的 User-Agent。BLS 拒绝访问（403）时，按其要求写上联系方式，如 MarketLens/0.4 (you@example.com)
EVENTS_UA=
# 可选：追加新闻 RSS，名称|地址，多个用逗号分隔（地址里不能有逗号），如 FXStreet|https://www.fxstreet.com/rss/news
NEWS_FEEDS=
# 可选：日历存储目录（默认 var/events）
EVENTS_DIR=

# 桌宠 Cirra 播报：不用配置，Cirra 开着时自动找到她。可选：她的 endpoint 文件位置（默认 ~/.cirra/endpoint.json，和 Cirra 用同一个变量名）
CIRRA_ENDPOINT_FILE=
# 常驻预警：页面关着时代理也看价位和情景，交给 Cirra（她没开时不取数）。
# 默认不开：现在由 Cirra 的插件“MarketLens 行情”自己看（代理没开也行）；两边都开会说两遍。
# 不用那个插件时才填：gold 看黄金 1h；或 名称|etoro或yahoo|代码|周期|小数位，分号隔开
CIRRA_WATCH=
# 轮询间隔（分钟，默认 5，最小 1）；状态文件默认 var/watch.json
CIRRA_WATCH_POLL_MIN=
CIRRA_WATCH_FILE=
# 持仓看守：页面关着时代理也看我的止损 / 止盈、新开仓时对照守则，交给 Cirra（只有一句话，不带金额）。
# 行情密钥和交易密钥都配了才有；说不说在页面预警页的“页面关着也说”里勾，默认都不说（不说时也不读持仓）。
# 不填 = 看黄金 GOLD；off = 不看；或 名称|eToro 代码|小数位|货币，分号隔开（例：黄金 GOLD|GOLD|2;欧元|EURUSD|5|EUR,USD）
CIRRA_POS=
# 状态文件（开关、记下的持仓、布防状态），默认 var/poswatch.json
CIRRA_POS_FILE=

# AI 分析：“复制分析包”不用配置。“让 Cirra 分析”（用 Cirra 聊天的那个模型）要她有 POST /ask 接口，
# 这个接口没有进 Cirra 的主线，所以按钮默认收起；你的 Cirra 带这个接口时写 1 才显示
CIRRA_ASK=
# “让 Cirra 分析”每天最多几次，默认 20
AI_DAILY=20
# 可选：AI 分析记录的目录（默认 var/ai）
AI_LOG_DIR=

# 可选：交易日记与我的守则存在哪（默认 var/journal.json，只在本机）
JOURNAL_FILE=

# 本地代理只监听本机
HOST=127.0.0.1
PORT=8787
